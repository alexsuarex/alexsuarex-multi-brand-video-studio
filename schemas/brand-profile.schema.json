{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/multi-brand-video-studio/brand-profile.schema.json",
  "title": "Brand Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "brandId",
    "displayName",
    "status",
    "messaging",
    "visual",
    "channels",
    "compliance"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "brandId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "pageName": { "type": ["string", "null"] },
    "status": { "enum": ["draft", "active", "archived"] },
    "messaging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "offers", "audiences", "tone", "languages"],
      "properties": {
        "purpose": { "type": "string" },
        "offers": { "type": "array", "items": { "type": "string" } },
        "audiences": { "type": "array", "items": { "type": "string" } },
        "tone": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "languages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "taglines": { "type": "array", "items": { "type": "string" } }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "fontFamilies", "logoPaths", "captionStyle", "ctaStyle"],
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "fontFamilies": { "type": "array", "items": { "type": "string" } },
        "logoPaths": { "type": "array", "items": { "type": "string" } },
        "captionStyle": { "type": "string" },
        "ctaStyle": { "type": "string" },
        "safeZoneNotes": { "type": "string" }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "formats"],
        "properties": {
          "name": { "type": "string" },
          "formats": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedClaims", "forbiddenClaims", "requiredDisclaimers"],
      "properties": {
        "allowedClaims": { "type": "array", "items": { "type": "string" } },
        "forbiddenClaims": { "type": "array", "items": { "type": "string" } },
        "requiredDisclaimers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "defaultCta": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["label", "action"],
      "properties": {
        "label": { "type": "string" },
        "action": { "type": "string" },
        "destinationRef": { "type": ["string", "null"] }
      }
    }
  }
}

