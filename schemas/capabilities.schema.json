{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/multi-brand-video-studio/capabilities.schema.json",
  "title": "Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifiedAt", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "implementation", "kind", "status", "constraints"],
        "properties": {
          "capability": { "type": "string", "pattern": "^[a-z]+(?:[.-][A-Za-z0-9]+)+$" },
          "implementation": { "type": "string" },
          "kind": { "enum": ["skill", "tool", "provider", "local", "manual"] },
          "status": { "enum": ["available", "unavailable", "approval-required", "unknown"] },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "source": { "type": ["string", "null"] }
        }
      }
    }
  }
}

