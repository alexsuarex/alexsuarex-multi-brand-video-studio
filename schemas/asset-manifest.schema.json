{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/multi-brand-video-studio/asset-manifest.schema.json",
  "title": "Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projectId": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "path", "kind", "origin", "rightsStatus", "provider", "promptRef", "checksum", "status"],
        "properties": {
          "assetId": { "type": "string" },
          "path": { "type": "string" },
          "kind": { "enum": ["video", "image", "audio", "font", "logo", "caption", "project", "other"] },
          "origin": { "enum": ["user", "licensed", "generated", "local", "recorded"] },
          "rightsStatus": { "enum": ["verified", "pending", "not-applicable"] },
          "provider": { "type": ["string", "null"] },
          "modelVersion": { "type": ["string", "null"] },
          "promptRef": { "type": ["string", "null"] },
          "checksum": { "type": ["string", "null"] },
          "status": { "enum": ["planned", "generated", "approved", "rejected", "missing"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}

